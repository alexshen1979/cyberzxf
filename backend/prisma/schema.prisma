generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  unionId    String?  @unique @map("union_id")
  mpOpenId   String?  @unique @map("mp_open_id")
  miniOpenId String?  @unique @map("mini_open_id")
  nickname   String?
  avatar     String?
  phone      String?
  status     Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  pointsAccount        PointsAccount?
  pointsTransactions   PointsTransaction[]
  orders               Order[]
  consultationRecords  ConsultationRecord[]
  favorites            Favorite[]

  @@map("users")
}

model PointsAccount {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0)
  frozen    Int      @default(0)
  expiredAt DateTime @map("expired_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("points_accounts")
}

model PointsTransaction {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String
  amount       Int
  balanceAfter Int      @map("balance_after")
  source       String?
  sourceId     String?  @map("source_id")
  remark       String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("points_transactions")
}

model Order {
  id          String    @id @default(uuid())
  orderNo     String    @unique @map("order_no")
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String    @map("product_id")
  productName String    @map("product_name")
  amount      Int
  points      Int
  bonusPoints Int       @default(0) @map("bonus_points")
  status      String    @default("pending")
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("orders")
}

model ConsultationRecord {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId  String   @map("session_id")
  question   String
  answer     String
  model      String
  pointsCost Int      @map("points_cost")
  channel    String   @default("miniprogram")
  type       String   @default("normal")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, sessionId])
  @@map("consultation_records")
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, targetType, targetId])
  @@index([userId])
  @@map("favorites")
}

model Article {
  id        String   @id @default(uuid())
  title     String
  content   String
  cover     String?
  category  String
  status    String   @default("published")
  viewCount Int      @default(0) @map("view_count")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("articles")
}

model AiConfig {
  id             String   @id @default(uuid())
  model          String   @default("deepseek-chat")
  temperature    Float    @default(0.7)
  maxTokens      Int      @default(2000) @map("max_tokens")
  topP           Float    @default(0.9) @map("top_p")
  contextWindow  Int      @default(10) @map("context_window")
  skillEnabled   Boolean  @default(true) @map("skill_enabled")
  skillWeight    Float    @default(0.6) @map("skill_weight")
  pointsPerQuery Int      @default(5) @map("points_per_query")
  pointsPerDeep  Int      @default(18) @map("points_per_deep")
  freeAskLimit   Int      @default(2) @map("free_ask_limit")
  apiKey         String?  @map("api_key")
  apiBaseUrl     String?  @map("api_base_url")
  timeout        Int      @default(30000)
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("ai_config")
}

model Skill {
  id           String   @id @default(uuid())
  name         String
  description  String?
  systemPrompt String   @map("system_prompt")
  model        String   @default("deepseek-chat")
  temperature  Float?
  maxTokens    Int?     @map("max_tokens")
  topP         Float?   @map("top_p")
  keywords     String   @default("[]")
  status       String   @default("enabled")
  isDefault    Boolean  @default(false) @map("is_default")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("skills")
}

model SystemNotice {
  id          String    @id @default(uuid())
  title       String
  content     String
  type        String    @default("notice")
  status      String    @default("published")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("system_notices")
}

model QuickQuestion {
  id        String   @id @default(uuid())
  question  String
  category  String   @default("general")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("quick_questions")
}

model AutoReplyRule {
  id           String   @id @default(uuid())
  keyword      String
  matchMode    String   @default("exact") @map("match_mode")
  replyType    String   @default("text") @map("reply_type")
  replyContent String   @map("reply_content")
  status       String   @default("enabled")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("auto_reply_rules")
}

model KnowledgeEntry {
  id         String   @id @default(uuid())
  title      String
  content    String                                          // Markdown 内容
  category   String                                          // 分类：招生简章/专业解读/院校信息/政策法规/分数线
  tags       String   @default("[]")                         // JSON 字符串数组
  sourceName String?  @map("source_name")                    // 来源名称
  sourceUrl  String?  @map("source_url")                     // 来源URL
  sourceDate String?  @map("source_date")                    // 来源日期
  status     String   @default("published")                  // published | draft
  viewCount  Int      @default(0) @map("view_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("knowledge_entries")
}

model WechatMenu {
  id        String   @id @default(uuid())
  name      String
  type      String
  key       String?
  url       String?
  appId     String?  @map("app_id")
  pagePath  String?  @map("page_path")
  parentId  String?  @map("parent_id")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("wechat_menus")
}

model Admin {
  id        String    @id @default(uuid())
  username  String    @unique
  password  String
  role      String    @default("admin")
  status    Int       @default(1)
  lastLogin DateTime? @map("last_login")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("admins")
}
