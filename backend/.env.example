# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="file:./prisma/dev.db"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-jwt-secret-here"
JWT_EXPIRES_IN="7d"

# WeChat Mini Program
WECHAT_MINI_APPID="wx_mini_appid"
WECHAT_MINI_SECRET="wx_mini_secret"

# WeChat Official Account
WECHAT_MP_APPID="wx_mp_appid"
WECHAT_MP_SECRET="wx_mp_secret"
WECHAT_MP_TOKEN="wx_mp_token"
WECHAT_MP_AES_KEY="wx_mp_aes_key"

# WeChat Pay
WECHAT_PAY_MCHID="wx_pay_mchid"
WECHAT_PAY_API_KEY="wx_pay_api_key"
WECHAT_PAY_APIV3_KEY="32_characters_wechat_pay_apiv3_key"
WECHAT_PAY_SERIAL_NO="wx_pay_serial_no"
WECHAT_PAY_PRIVATE_KEY_PATH="/path/to/apiclient_key.pem"
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH="/path/to/wechatpay_platform_public_key.pem"
WECHAT_PAY_NOTIFY_URL="https://your-domain.com/api/v1/payments/callback"

# WeChat Mini Program Virtual Payment
# Configure in 小程序管理后台 -> 虚拟支付 -> 基础配置 / 道具管理.
# wechat_pay keeps the current online version working. auto lets the new mini program use virtual payment while old versions keep WeChat Pay.
RECHARGE_PAY_MODE="wechat_pay"
WECHAT_VIRTUAL_PAY_OFFER_ID="your_virtual_pay_offer_id"
WECHAT_VIRTUAL_PAY_APP_KEY="your_virtual_pay_app_key"
WECHAT_VIRTUAL_PAY_SANDBOX_APP_KEY="your_virtual_pay_sandbox_app_key"
WECHAT_VIRTUAL_PAY_ENV="0"
WECHAT_VIRTUAL_PAY_PUSH_TOKEN="CyberZhangVP2026"
# Optional. Defaults to using recharge product IDs such as pkg_120 as WeChat productId.
# Example: {"pkg_120":"pkg_120","pkg_280":"pkg_280","pkg_560":"pkg_560","pkg_1000":"pkg_1000"}
WECHAT_VIRTUAL_PAY_PRODUCT_MAP=""

# DeepSeek API
DEEPSEEK_API_KEY="sk-your-deepseek-api-key"
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Cloud Storage
OSS_ENDPOINT="oss-cn-hangzhou.aliyuncs.com"
OSS_BUCKET="zhangshi"
OSS_ACCESS_KEY="oss_access_key"
OSS_ACCESS_SECRET="oss_access_secret"
