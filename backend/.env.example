# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="mysql://root:password@localhost:3306/cyberzhang"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-jwt-secret-here"
JWT_EXPIRES_IN="7d"

# WeChat Mini Program
WECHAT_MINI_APPID="wx_mini_appid"
WECHAT_MINI_SECRET="wx_mini_secret"

# WeChat Official Account
WECHAT_MP_APPID="wx_mp_appid"
WECHAT_MP_SECRET="wx_mp_secret"
WECHAT_MP_TOKEN="wx_mp_token"
WECHAT_MP_AES_KEY="wx_mp_aes_key"

# WeChat Pay
WECHAT_PAY_MCHID="wx_pay_mchid"
WECHAT_PAY_API_KEY="wx_pay_api_key"
WECHAT_PAY_SERIAL_NO="wx_pay_serial_no"
WECHAT_PAY_PRIVATE_KEY_PATH="/path/to/apiclient_key.pem"

# DeepSeek API
DEEPSEEK_API_KEY="sk-your-deepseek-api-key"
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Cloud Storage
OSS_ENDPOINT="oss-cn-hangzhou.aliyuncs.com"
OSS_BUCKET="cyberzhang"
OSS_ACCESS_KEY="oss_access_key"
OSS_ACCESS_SECRET="oss_access_secret"
