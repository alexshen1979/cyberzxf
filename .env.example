# ==============================================================
# 赛博张老师 AI 升学咨询平台 — 环境变量配置
# ==============================================================
# 复制此文件为 .env 并填写实际值
# cp .env.example .env

# ─── 基础 ──────────────────────────────────────────────
NODE_ENV=production
PORT=3000
DATABASE_URL=file:/data/cyberzhang.db

# ─── JWT ───────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_IN=7d

# ─── DeepSeek API ──────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ─── Redis（可选，用于多实例部署） ──────────────────────
# REDIS_URL=redis://localhost:6379

# ─── 微信小程序 ────────────────────────────────────────
WECHAT_MINI_APPID=wx_your_mini_appid
WECHAT_MINI_SECRET=your_mini_secret

# ─── 微信公众号 ────────────────────────────────────────
WECHAT_MP_APPID=wx_your_mp_appid
WECHAT_MP_SECRET=your_mp_secret
WECHAT_MP_TOKEN=your_token
# WECHAT_MP_AES_KEY=your_aes_key

# ─── 微信支付（可选） ───────────────────────────────────
# WECHAT_PAY_MCHID=your_mch_id
# WECHAT_PAY_API_KEY=your_api_key
# WECHAT_PAY_SERIAL_NO=your_serial_no
# WECHAT_PAY_PRIVATE_KEY_PATH=/path/to/apiclient_key.pem

# ─── OSS 对象存储（可选） ───────────────────────────────
# OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
# OSS_BUCKET=cyberzhang
# OSS_ACCESS_KEY=your_access_key
# OSS_ACCESS_SECRET=your_access_secret
