FROM node:20-alpine

RUN apk add --no-cache wget

WORKDIR /app

# Install all dependencies (need prisma + tsx for runtime migrate/seed)
COPY package.json package-lock.json* ./
RUN npm ci

COPY tsconfig.json ./
COPY prisma ./prisma
COPY src ./src
COPY src/assets ./dist/assets
COPY scripts ./scripts
COPY start.sh ./

RUN npx prisma generate
RUN npm run build
RUN chmod +x start.sh

EXPOSE 3000

CMD ["./start.sh"]
